# Qdrant Configuration
# Option 1: Qdrant Cloud
QDRANT_URL=https://seu-servidor-qdrant.cloud.io:6333
QDRANT_API_KEY=sua_api_key

# Option 2: Qdrant Local
# QDRANT_LOCAL_PATH=./qdrant_data

# Default collection name
COLLECTION_NAME=synapstor

# Embedding configuration
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking settings
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_SEPARATORS=["\n\n", "\n", ". ", ", "]

# Tagging settings
TAG_SIMILARITY_THRESHOLD=0.8

# MCP tools settings
TOOL_STORE_DESCRIPTION=Store information for later retrieval.
TOOL_FIND_DESCRIPTION=Find related information in the vector database.
TOOL_CHUNK_DESCRIPTION=Split a document into parts and store them.

# MCP Server HTTP settings (for --transport http)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_CORS_ORIGINS=["*"]

# Matrix Embedding Framework (MEF) settings
# Enable MEF processing for YAML files with UKI structure
MEF_ENABLED=false
MEF_ENFORCE_STRUCTURE=false
MEF_AUTO_DETECT=true

# MEF validation settings (customize as needed)
MEF_REQUIRED_FIELDS=["id", "title", "domain", "type", "content"]
MEF_SUPPORTED_DOMAINS=["product", "business", "technical", "strategy", "culture"]
MEF_SUPPORTED_TYPES=["business_rule", "function", "template", "guideline", "pattern", "decision", "example"]
MEF_SUPPORTED_CONTEXTS=["discovery", "implementation", "refinement", "qa", "documentation", "support"]

# Internationalization
SYNAPSTOR_LANGUAGE=en
SYNAPSTOR_AUTO_DETECT_LANGUAGE=true

# General settings
PROJECT_NAME=Semantic Synapstor
LOG_LEVEL=INFO
